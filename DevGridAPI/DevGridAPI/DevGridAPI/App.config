<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="ReviewDb" connectionString="XpoProvider=MSSqlServer;data source=YOUR_DB_SERVER;user id=;password=;initial catalog=YOUR_DATABASE;Persist Security Info=true" />
        <add name="JsonConnection" connectionString="Uri=&quot;https://kosis.kr/openapi/statisticsData.do?method=getList&amp;apiKey=YOUR_KOSIS_API_KEY&amp;format=json&amp;jsonVD=Y&amp;userStatsId=YOUR_USER_STATS_ID&amp;prdSe=M&amp;newEstPrdCnt=3&quot;" providerName="JsonSourceProvider" />
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <runtime>
